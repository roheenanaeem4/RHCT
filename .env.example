# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Facebook Page
FB_PAGE_ID=your_facebook_page_id_here
FB_ACCESS_TOKEN=your_facebook_page_access_token_here

# Twilio (voice call agent)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX        # your Twilio number (given when you sign up)
RECIPIENT_PHONE_NUMBER=+923XXXXXXXXX    # your mobile number (Pakistan format)
